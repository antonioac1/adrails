# m h dom mon dow  - one content run Mon + Thu 06:10, results + lessons on the 1st; publish stays manual (human mode)
10 6 * * 1,4  . $HOME/.config/adrails/writers.env && adsops-mcp seo-run --profile $HOME/adrails-seo/site-profile.json --config $HOME/adrails/config.json >> $HOME/adrails-seo/state/cron.log 2>&1
20 6 1 * *    adsops-mcp seo-run --stage results --update-lessons --profile $HOME/adrails-seo/site-profile.json --config $HOME/adrails/config.json >> $HOME/adrails-seo/state/cron.log 2>&1
